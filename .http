### Upload
PUT http://localhost:4004/odata/v4/catalog/ErrorFilesSet('6553ca12-ab8b-4a4c-92b0-0f69db0829b4')/ErrorPayloadFile/$value
Content-Type: text/csv
PayloadFileName: samplexml.csv
MIMEType:text/csv

 < ./files/samplexml.csv
#  < ./files/samplexml.xml
# < ./files/test_sample.pdf
