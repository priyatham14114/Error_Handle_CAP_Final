<mvc:View
    controllerName="com.app.errorhandleuifa.controller.Home"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:w="sap.ui.integration.widgets"
    xmlns:cssgrid="sap.ui.layout.cssgrid"
    xmlns:layout="sap.ui.layout"
    xmlns:suite="sap.suite.ui.commons"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:core="sap.ui.core"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
>
    <ScrollContainer
        id="scrollContainer"
        horizontal="false"
        vertical="true"
        width="100%"
        height="100%"
    >
        <VBox
            id="_IDGenVBox"
            width="100%"
        >
            <f:ShellBar
                id="_IDGenShellBar"
                title="POC-EH"
                secondTitle="Overview"
                homeIcon="sap-icon://home"
                class=""
            />
            <IconTabBar
                id="idIconTabBar"
                select="handleIconTabBarSelect"
                headerBackgroundDesign="Transparent"
                class="sapUiResponsiveContentPadding sapUiSmallMarginBegin"
            >
                <items>
                    <IconTabFilter
                        id="_IDGenIconTabFilter"
                        text="Unit-1"
                    >
                        <Title
                            id="_IDGenTitle1"
                            text="All Errors"
                            titleStyle="H3"
                            class="sapUiSmallMarginBegin"
                        />
                        <f:GridContainer id="_IDGenGridContainer2">
                            <f:layout>
                                <f:GridContainerSettings
                                    id="_IDGenGridContainerSetting"
                                    rowSize="3rem"
                                    columnSize="5rem"
                                    gap="1rem"
                                />
                            </f:layout>
                            <f:layoutS>
                                <f:GridContainerSettings
                                    id="_IDGenGridContainerSettingsf2"
                                    rowSize="5rem"
                                    columnSize="5rem"
                                    gap="0.5rem"
                                />
                            </f:layoutS>
                            <!-- Custom Cars -->
                            <!-- card1 -->
                            <w:Card
                                id="totalErrorsCardf2"
                                manifest="{manifests>/TotalErrors}"
                                action="onAction_TotalErrors"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="_IDGenGridContainerItemLayoutData1f2"
                                        minRows="4"
                                        columns="3"
                                    />
                                </w:layoutData>
                            </w:Card>
                            <!-- card2 -->
                            <w:Card
                                id="totalReprocessSuccessCardf2"
                                manifest="{manifests>/TotalSuccess}"
                                action="onAction_Success"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="_IDGenGridContainerItemLayoutData2f2"
                                        minRows="4"
                                        columns="3"
                                    />
                                </w:layoutData>
                            </w:Card>
                            <!-- card3 -->
                            <w:Card
                                id="totalReprocessFailedCardf2"
                                manifest="{manifests>/TotalFailed}"
                                action="onAction_FailedErrors"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="_IDGenGridContainerItemLayoutData3f2"
                                        minRows="4"
                                        columns="3"
                                    />
                                </w:layoutData>
                            </w:Card>
                            <!-- card4 -->
                            <w:Card
                                id="totalNoRetriesYetf2"
                                manifest="{manifests>/NoRetries}"
                                action="onAction_NoRetries"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="_IDGenGridContainerItemL3f2"
                                        minRows="4"
                                        columns="3"
                                    />
                                </w:layoutData>
                            </w:Card>
                            <!-- <w:Card
                                id="LineChartCard"
                                manifest="{manifests>/LineChart}"
                                action="onAction"
                                height="320px"
                                width="300px"

                            /> -->
                        </f:GridContainer>
                        <Title
                            id="_IDGenTitlef2"
                            text="Incidents"
                            titleStyle="H3"
                            class="sapUiSmallMarginBegin"
                        />
                        <f:GridContainer id="_IDGenGridContainer1f2">
                            <f:layout>
                                <f:GridContainerSettings
                                    id="_IDGenGridContainerSettings2f2"
                                    rowSize="5rem"
                                    columnSize="5rem"
                                    gap="1rem"
                                />
                            </f:layout>
                            <f:layoutS>
                                <f:GridContainerSettings
                                    id="_IDGenGridContainerSettings3f2"
                                    rowSize="5rem"
                                    columnSize="5rem"
                                    gap="0.5rem"
                                />
                            </f:layoutS>
                            <!-- Recent Table -->
                            <w:Card
                                id="todayRecordsCardf2"
                                manifest="{manifests>/RecentTable}"
                                action="onAction_Recentlogs"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="idGridContainerItemLayoutDataf2"
                                        rows="5"
                                        columns="6"
                                    />
                                </w:layoutData>
                            </w:Card>
                            <!-- line chart by status -->
                            <w:Card
                                id="LineChartCardf2"
                                manifest="{manifests>/LineChart}"
                                action="onAction"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="idGridContainerItemLayoutData_sf2"
                                        rows="5"
                                        columns="9"
                                    />
                                </w:layoutData>
                            </w:Card>
                            <!-- barchart by ststus -->
                            <w:Card
                                id="IdBarchart_Cardf2"
                                manifest="{manifests>/ErrorStatusBar}"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="_IDGenGridContainerIdBarchart_Cardf2"
                                        rows="6"
                                        columns="15"
                                    />
                                </w:layoutData>
                            </w:Card>
                            <!-- dount -->
                            <w:Card
                                id="IdDonutCardf2"
                                manifest="{manifests>/Donut}"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="_IDGenGridContainerItemLayoutData5f2"
                                        rows="4"
                                        columns="4"
                                    />
                                </w:layoutData>
                            </w:Card>
                            <!-- barchert by date -->

                            <w:Card
                                id="IdBarchart_Cardbydatef2"
                                manifest="{manifests>/ErrorCountBarChart}"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="_IDGenGridContainerIdBarchart_bydateCardf2"
                                        rows="4"
                                        columns="11"
                                    />
                                </w:layoutData>
                            </w:Card>
                        </f:GridContainer>
                    </IconTabFilter>
                    <IconTabFilter id="_IDGenIconTabFilter1" text="Unit-2" >

                    <!-- test -->
                    <Title
                            id="_IDGenTitle2"
                            text="All File Errors"
                            titleStyle="H3"
                            class="sapUiSmallMarginBegin"
                        />
                        <f:GridContainer id="_IDGenGridContainer">
                            <f:layout>
                                <f:GridContainerSettings
                                    id="_IDGenGridContainerSettings"
                                    rowSize="3rem"
                                    columnSize="5rem"
                                    gap="1rem"
                                />
                            </f:layout>
                            <f:layoutS>
                                <f:GridContainerSettings
                                    id="_IDGenGridContainerSettings1"
                                    rowSize="5rem"
                                    columnSize="5rem"
                                    gap="0.5rem"
                                />
                            </f:layoutS>
                            <!-- Custom Cars -->
                            <!-- card1 -->
                            <w:Card
                                id="totalErrorsCard"
                                manifest="{filemanifests>/TotalErrorFiles}"
                                action="onAction_AllFiles"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="_IDGenGridContainerItemLayoutData1"
                                        minRows="4"
                                        columns="3"
                                    />
                                </w:layoutData>
                            </w:Card>
                            <!-- card2 -->
                            <w:Card
                                id="totalReprocessSuccessCard"
                                manifest="{filemanifests>/TotalSuccessFiles}"
                                action="onAction_SuccessFiles"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="_IDGenGridContainerItemLayoutData2"
                                        minRows="4"
                                        columns="3"
                                    />
                                </w:layoutData>
                            </w:Card>
                            <!-- card3 -->
                            <w:Card
                                id="totalReprocessFailedCard"
                                manifest="{filemanifests>/TotalFailedFiles}"
                                action="onAction_FailedFiles"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="_IDGenGridContainerItemLayoutData3"
                                        minRows="4"
                                        columns="3"
                                    />
                                </w:layoutData>
                            </w:Card>
                            <!-- card4 -->
                            <w:Card
                                id="totalNoRetriesYet"
                                manifest="{filemanifests>/NoRetriesFiles}"
                                action="onAction_NoTriesFiles"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="_IDGenGridContainerItemL3"
                                        minRows="4"
                                        columns="3"
                                    />
                                </w:layoutData>
                            </w:Card>
                            <!-- <w:Card
                                id="LineChartCard"
                                manifest="{manifests>/LineChart}"
                                action="onAction"
                                height="320px"
                                width="300px"

                            /> -->
                        </f:GridContainer>
                        <Title
                            id="_IDGenTitle"
                            text="Incidents"
                            titleStyle="H3"
                            class="sapUiSmallMarginBegin"
                        />
                        <f:GridContainer id="_IDGenGridContainer1">
                            <f:layout>
                                <f:GridContainerSettings
                                    id="_IDGenGridContainerSettings2"
                                    rowSize="5rem"
                                    columnSize="5rem"
                                    gap="1rem"
                                />
                            </f:layout>
                            <f:layoutS>
                                <f:GridContainerSettings
                                    id="_IDGenGridContainerSettings3"
                                    rowSize="5rem"
                                    columnSize="5rem"
                                    gap="0.5rem"
                                />
                            </f:layoutS>
                            <!-- Recent Table -->
                            <w:Card
                                id="todayRecordsCard"
                                manifest="{filemanifests>/RecentTableFiles}"
                                action="onAction"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="idGridContainerItemLayoutData"
                                        rows="5"
                                        columns="6"
                                    />
                                </w:layoutData>
                            </w:Card>
                            <!-- line chart by status -->
                            <w:Card
                                id="LineChartCard"
                                manifest="{filemanifests>/LineChartFiles}"
                                action="onAction"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="idGridContainerItemLayoutData_s"
                                        rows="5"
                                        columns="9"
                                    />
                                </w:layoutData>
                            </w:Card>
                            <!-- barchart by ststus -->
                            <w:Card
                                id="IdBarchart_Card"
                                manifest="{filemanifests>/ErrorStatusBarFiles}"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="_IDGenGridContainerIdBarchart_Card"
                                        rows="6"
                                        columns="15"
                                    />
                                </w:layoutData>
                            </w:Card>
                            <!-- dount -->
                            <w:Card
                                id="IdDonutCard"
                                manifest="{filemanifests>/DonutFiles}"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="_IDGenGridContainerItemLayoutData5"
                                        rows="4"
                                        columns="4"
                                    />
                                </w:layoutData>
                            </w:Card>
                            <!-- barchert by date -->

                            <w:Card
                                id="IdBarchart_Cardbydate"
                                manifest="{filemanifests>/ErrorCountBarChartFiles}"
                            >
                                <w:layoutData>
                                    <f:GridContainerItemLayoutData
                                        id="_IDGenGridContainerIdBarchart_bydateCard"
                                        rows="4"
                                        columns="11"
                                    />
                                </w:layoutData>
                            </w:Card>
                        </f:GridContainer>
                    <!-- test -->

                    </IconTabFilter>
			<!-- <IconTabFilter text="Drone Maintenance" />
			<IconTabFilter text="Drone Development" /> -->
                </items>
            </IconTabBar>
            <!-- Bars start -->
            <suite:ChartContainer
                id="chartContainer123"
                width="100%"
            >
                <suite:content>
                    <suite:ChartContainerContent id="chartContainerContent333">
                        <suite:content>
                            <viz:VizFrame
                                id="idBarChart"
                                width="auto"
                                height="600px"
                                uiConfig="{applicationSet:'fiori'}"
                                vizType="column"
                                vizProperties="{
                        plotArea: {
                            dataLabel: {visible: true},
                                    colorPalette: ['rgba(0, 153, 255, 1)','rgba(123, 142, 29, 1)','rgba(181, 101, 11, 1)','rgba(214, 23, 112, 1)']

                        },
                        title: {text:'Day wise errors'},
                        valueAxis: {
                            title: {
                                visible: true,
                                text: 'Count'
                            },
                            label: {
                                formatString: '#,##0'
                            },
                            interval: {
                                value: 5
                            }
                        },
                        categoryAxis: {
                            title: {
                                visible: true,
                                text: 'Date'
                            }
                        }
                    }"
                                selectData="onSelectData"
                                renderComplete="handleRenderComplete"
                            >
                                <viz:dataset>
                                    <viz.data:FlattenedDataset
                                        id="flattenData0"
                                        data="{oChartModel>/value}"
                                    >
                                        <viz.data:dimensions>
                                            <viz.data:DimensionDefinition
                                                id="_IDGenDimensionDefinition2"
                                                name="Date"
                                                value="{oChartModel>errorDate}"
                                            />
                                        </viz.data:dimensions>
                                        <viz.data:measures>
                                            <viz.data:MeasureDefinition
                                                id="_IDGenMeasureDefinition4"
                                                name="TotalErrors"
                                                value="{oChartModel>errorCount}"
                                            />
                                            <viz.data:MeasureDefinition
                                                id="_IDGenMeasureDefinition2"
                                                name="Success"
                                                value="{oChartModel>successCount}"
                                            />
                                            <viz.data:MeasureDefinition
                                                id="_IDGenMeasureDefinition3"
                                                name="Failed"
                                                value="{oChartModel>failedCount}"
                                            />
                                            <viz.data:MeasureDefinition
                                                id="_IDGenMeasureDefinitio"
                                                name="NoRetries"
                                                value="{oChartModel>noRetriesCount}"
                                            />
                                        </viz.data:measures>
                                    </viz.data:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <viz.feeds:FeedItem
                                        id="_IDGenFeedItem6"
                                        uid="valueAxis"
                                        type="Measure"
                                        values="TotalErrors,Success,Failed,NoRetries"
                                    />
                                    <viz.feeds:FeedItem
                                        id="_IDGenFeedItem7"
                                        uid="categoryAxis"
                                        type="Dimension"
                                        values="Date"
                                    />
                                </viz:feeds>
                                <viz:dependents>
                                    <viz:Popover id="idPopOver" />
                                </viz:dependents>
                            </viz:VizFrame>
                        </suite:content>
                    </suite:ChartContainerContent>
                </suite:content>
            </suite:ChartContainer>
            <!-- Bars end -->
        </VBox>
    </ScrollContainer>
</mvc:View>
