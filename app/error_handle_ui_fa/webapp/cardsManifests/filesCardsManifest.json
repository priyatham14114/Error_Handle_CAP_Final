    "DonutFiles": {
        "sap.app": {
            "id": "sample.CardsLayout.model.donut_Files",
            "type": "card"
        },
        "sap.card": {
            "type": "Analytical",
            "header": {
                "title": "All"
            },
            "configuration": {
                "parameters": {
                    "UIBasePath": "{config>/UIBasePath}"
                },
                "destinations": {
                    "srv": {
                        "name": "srv-api",
                        "defaultUrl": "{{parameters.UIBasePath}}/odata/v4/catalog/"
                    }
                }
            },
            "content": {
                "chartType": "Donut",
                "legend": {
                    "visible": true,
                    "position": "Bottom",
                    "alignment": "Left"
                },
                "plotArea": {
                    "dataLabel": {
                        "visible": true,
                        "showTotal": true
                    }
                },
                "title": {
                    "visible": false
                },
                "measureAxis": "size",
                "dimensionAxis": "color",
                "data": {
                    "request": {
                        "url": "{{destinations.srv}}/CatalogService.countErrorsDonutFiles()",
                        "parameters": {},
                        "headers": {}
                    },
                    "path": "/value/"
                },
                "dimensions": [
                    {
                        "label": "Identifier",
                        "value": "{Identifier}"
                    }
                ],
                "measures": [
                    {
                        "label": "Value",
                        "value": "{Value}"
                    }
                ]
            }
        }
    },
    "RecentTableFiles": {
        "sap.app": {
            "id": "Id_Recent_Table_Files",
            "type": "card"
        },
        "sap.card": {
            "type": "Table",
            "header": {
                "title": "Recent Error records"
            },
            "configuration": {
                "parameters": {
                    "UIBasePath": "{config>/UIBasePath}"
                },
                "destinations": {
                    "srv": {
                        "name": "srv-api",
                        "defaultUrl": "{{parameters.UIBasePath}}/odata/v4/catalog/"
                    }
                }
            },
            "content": {
                "data": {
                    "request": {
                        "url": "{{destinations.srv}}/CatalogService.recentErrorFiles()"
                    },
                    "path": "/value"
                },
                "row": {
                    "columns": [
                        {
                            "title": "IFlow Name",
                            "value": "{iFlow_name}"
                        },
                        {
                            "title": "Date",
                            "value": "{createdAt}"
                        },
                        {
                            "title": "Status",
                            "value": "{Status}",
                            "statusState": "Error"
                        },
                        {
                            "title": "Receiver System",
                            "value": "{Receiver_System}"
                        }
                    ],
                    "actions": [
                        {
                            "type": "Navigation",
                            "url": ""
                        }
                    ]
                },
                "maxItems": 9,
                "showNoData": true,
                "scrollable": true
            }
        }
    },
    "LineChartFiles": {
        "sap.app": {
            "type": "card"
        },
        "sap.card": {
            "type": "Analytical",
            "header": {
                "type": "Numeric",
                "title": "Error Status Trends",
                "subtitle": "Errors per iFlow by Status"
            },
            "configuration": {
                "parameters": {
                    "UIBasePath": "{config>/UIBasePath}"
                },
                "destinations": {
                    "srv": {
                        "name": "srv-api",
                        "defaultUrl": "{{parameters.UIBasePath}}/odata/v4/catalog/"
                    }
                }
            },
            "content": {
                "chartType": "Line",
                "title": {
                    "text": "Error Counts by Integration Flow",
                    "visible": true
                },
                "plotArea": {
                    "dataLabel": {
                        "visible": true
                    }
                },
                "legend": {
                    "visible": true,
                    "position": "Right"
                },
                "dimensionAxis": "categoryAxis",
                "measureAxis": "valueAxis",
                "data": {
                    "request": {
                        "url": "{{destinations.srv}}/FilesErrorSummarybyFlow"
                    },
                    "path": "/value"
                },
                "dimensions": [
                    {
                        "label": "Integration Flow",
                        "value": "{iFlow_name}"
                    }
                ],
                "measures": [
                    {
                        "label": "Total",
                        "value": "{TotalErrors}"
                    },
                    {
                        "label": "Failed",
                        "value": "{Failed}"
                    },
                    {
                        "label": "Success",
                        "value": "{Success}"
                    },
                    {
                        "label": "No Retry",
                        "value": "{NoRetries}"
                    }
                ]
            }
        }
    },
    "ErrorStatusBarFiles": {
        "sap.app": {
            "id": "Id_ErrorStatus_Bar_Files_By_Status",
            "type": "card"
        },
        "sap.card": {
            "type": "Analytical",
            "header": {
                "title": "Error Count by Status",
                "subTitle": "Grouped by Integration Flow"
            },
            "configuration": {
                "parameters": {
                    "UIBasePath": "{config>/UIBasePath}"
                },
                "destinations": {
                    "srv": {
                        "name": "srv-api",
                        "defaultUrl": "{{parameters.UIBasePath}}/odata/v4/catalog/"
                    }
                }
            },
            "content": {
                "chartType": "column",
                "chartProperties": {
                    "legend": {
                        "visible": true
                    },
                    "plotArea": {
                        "dataLabel": {
                            "visible": true,
                            "showTotal": false
                        }
                    },
                    "title": {
                        "text": "Errors by Integration Flow",
                        "alignment": "bottom"
                    }
                },
                "data": {
                    "request": {
                        "url": "{{destinations.srv}}/FilesErrorSummarybyFlow"
                    },
                    "path": "/value"
                },
                "dimensions": [
                    {
                        "name": "IntegrationFlow",
                        "value": "{iFlow_name}"
                    }
                ],
                "measures": [
                    {
                        "name": "Total Errors",
                        "value": "{TotalErrors}"
                    },
                    {
                        "name": "Failed",
                        "value": "{Failed}"
                    },
                    {
                        "name": "Success",
                        "value": "{Success}"
                    },
                    {
                        "name": "No Retries",
                        "value": "{NoRetries}"
                    }
                ],
                "feeds": [
                    {
                        "type": "Dimension",
                        "uid": "categoryAxis",
                        "values": [
                            "IntegrationFlow"
                        ]
                    },
                    {
                        "type": "Measure",
                        "uid": "valueAxis",
                        "values": [
                            "Total Errors",
                            "Failed",
                            "Success",
                            "No Retries"
                        ]
                    }
                ]
            }
        }
    },
    "ErrorCountBarChartFiles": {
        "sap.app": {
            "id": "Id_ErrorStatus_Bar_Files_Date",
