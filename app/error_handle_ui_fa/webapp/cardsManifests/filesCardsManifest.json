{
    "TotalErrorFiles": {
        "sap.app": {
            "id": "Id_Total_Error_files",
            "type": "card"
        },
        "sap.card": {
            "type": "Object",
            "header": {
                "type": "Numeric",
                "icon": {
                    "src": "sap-icon://sum"
                },
                "data": {
                    "request": {
                        "url": "{{destinations.srv}}/CatalogService.dashboardKPIsFiles()",
                        "method": "GET"
                    },
                    "path": ""
                },
                "title": "Total Errors",
                "subtitle": "All errors related to files",
                "unitOfMeasurement": "records",
                "mainIndicator": {
                    "number": "{totalErrorFilesCount}",
                    "unit": "records",
                    "state": "Error"
                },
                "details": "",
                "sideIndicators": [
                    {
                        "title": "",
                        "number": "",
                        "unit": ""
                    }
                ]
            },
            "configuration": {
                "parameters": {
                    "UIBasePath": "{config>/UIBasePath}"
                },
                "destinations": {
                    "srv": {
                        "name": "srv-api",
                        "defaultUrl": "{{parameters.UIBasePath}}/odata/v4/catalog/"
                    }
                }
            },
            "actions": [
                {
                    "type": "Navigation",
                    "url": ""
                }
            ],
            "content": {
                "data": {
                    "request": {
                        "url": "{{destinations.srv}}/CatalogService.dashboardKPIsFiles()",
                        "method": "GET"
                    },
                    "path": "/"
                },
                "groups": [
                    {
                        "title": "",
                        "items": [
                            {
                                "label": "All errors received from CPI",
                                "value": "{totalErrorFilesCount}"
                            }
                        ]
                    }
                ]
            }
        }
    },
