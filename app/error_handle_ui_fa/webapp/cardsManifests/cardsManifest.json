                    }
                ],
                "measures": [
                    {
                        "name": "Total Errors",
                        "value": "{errorCount}"
                    },
                    {
                        "name": "Failed",
                        "value": "{failedCount}"
                    },
                    {
                        "name": "Success",
                        "value": "{successCount}"
                    },
                    {
                        "name": "No Retries",
                        "value": "{noRetriesCount}"
                    }
                ],
                "feeds": [
                    {
                        "type": "Dimension",
                        "uid": "categoryAxis",
                        "values": [
                            "Date"
                        ]
                    },
                    {
                        "type": "Measure",
                        "uid": "valueAxis",
                        "values": [
                            "Total Errors",
                            "Failed",
                            "Success",
                            "No Retries"
                        ]
                    }
                ]
            }
        }
    }
}