{
    "TotalErrors": {
        "sap.app": {
            "id": "Id_Total_Errors",
            "type": "card"
        },
        "sap.card": {
            "type": "Object",
            "header": {
                "type": "Numeric",
                "icon": {
                    "src": "sap-icon://sum"
                },
                "data": {
                    "request": {
                        "url": "{{destinations.srv}}/CatalogService.dashboardKPIsLogs()",
                        "method": "GET"
                    },
                    "path": ""
                },
                "title": "Total Errors",
                "subtitle": "All errors related to normal payload",
                "unitOfMeasurement": "records",
                "mainIndicator": {
                    "number": "{totalErrorLogCount}",
                    "unit": "records",
                    "state": "Error"
                },
                "details": "",
                "sideIndicators": [
                    {
                        "title": "",
                        "number": "",
                        "unit": ""
                    }
                ]
            },
            "configuration": {
                "parameters": {
                    "UIBasePath": "{config>/UIBasePath}"
                },
                "destinations": {
                    "srv": {
                        "name": "srv-api",
                        "defaultUrl": "{{parameters.UIBasePath}}/odata/v4/catalog/"
                    }
                }
            },
            "actions": [
                {
                    "type": "Navigation",
                    "url": ""
                }
            ],
            "content": {
                "data": {
                    "request": {
                        "url": "{{destinations.srv}}/CatalogService.dashboardKPIsLogs()",
                        "method": "GET"
                    },
                    "path": "/"
                },
                "groups": [
                    {
                        "title": "",
                        "items": [
                            {
                                "label": "All errors received from CPI",
                                "value": "{totalErrorLogCount}"
                            }
                        ]
                    }
                ]
            }
        }
    },
